# Values for docker-compose.yml (local only). Copy to ".env" at the repository root and replace the placeholders.
# Never commit .env. The cloud does not use this file: its values come from Secret Manager (Episode 5).
POSTGRES_USER=cafe
POSTGRES_DB=cafe
POSTGRES_PASSWORD=change-me-local-db-password
SESSION_SECRET=change-me-to-a-long-random-string
DEMO_USER_PASSWORD=change-me-demo-password
