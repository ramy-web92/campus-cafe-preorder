# Copy to .env.test. Tests reset this database before every run — never point it at your dev data.
DATABASE_URL="postgresql://cafe:cafe@localhost:5432/cafe_test?schema=public"
SESSION_SECRET="test-only-secret"
NODE_ENV="test"
SEED_DEMO_DATA="true"
# Any value of 8+ characters: the seed and the tests read the same variable.
DEMO_USER_PASSWORD="change-me-test-password"
