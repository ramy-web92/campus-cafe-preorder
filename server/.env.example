# Copy to .env and adjust. Never commit the real .env. Every variable the server reads is listed here.
# Full table (purpose, secret or not, where the cloud value comes from): docs/labs/lab-05/deployment.md

# PostgreSQL connection. SECRET in the cloud (Secret Manager).
DATABASE_URL="postgresql://cafe:cafe@localhost:5432/cafe?schema=public"

# Signs the session cookie. SECRET in the cloud. Required when NODE_ENV=production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Port the server listens on. Cloud Run sets it (3000).
PORT=3000

# development | test | production. The container sets production.
NODE_ENV="development"

# Demo accounts and sample orders for UAT. Default: true locally, false in production.
SEED_DEMO_DATA="true"

# Password of every demo account. SECRET in the cloud. Required when SEED_DEMO_DATA=true (8+ characters).
DEMO_USER_PASSWORD="change-me-demo-password"

# Allowed browser origins, comma-separated (only needed when the client runs on another origin, e.g. Vite dev).
# Default: http://localhost:5173 outside production, empty in production (same origin).
# CORS_ORIGIN="http://localhost:5173"

# Folder of the built React app served by the server. Default in production: ../client/dist.
# STATIC_DIR=""
